# ════════════════════════════════════════════════════════════════
#  NANO GATEWAY — environment template
#  Copy to `.env` and fill in. Never commit the real .env.
# ════════════════════════════════════════════════════════════════

# ── Database (MongoDB) ────────────────────────────────────────────
# The app uses a MongoDB instance. Point MONGODB_URI at a reachable
# MongoDB server (local, Atlas, or cloud).
MONGODB_URI="mongodb://localhost:27017"
# MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/nano_gateway"
# Database name within the MongoDB instance (defaults to "nano_gateway").
MONGODB_DB="nano_gateway"

# ── App ──────────────────────────────────────────────────────────
# The port the web app listens on. The dev/start scripts default to 3000 and
# honour PORT, e.g. `PORT=3005 npm run dev`. Keep NEXT_PUBLIC_APP_URL in sync —
# the gateway pushes realtime events to it.
PORT="3000"
# The address this app reaches ITSELF on: password-reset / verification links,
# the gateway's realtime event push, and the Pakasir webhook URL all derive
# from it. Behind a tunnel this is the loopback origin, which is correct —
# those are server-to-self calls.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The origin a VISITOR sees, used only for generated metadata: the browser-tab
# icon link and the `og:image` that link previews render. It must be absolute
# and publicly reachable, or shared links show no preview image.
# Read when the app is built, so set it before running `npm run build`.
SITE_URL="https://your-public-domain.example"
# next dev / npm run dev sets NODE_ENV=development itself; next start /
# npm run start sets NODE_ENV=production itself. Do NOT hard-code it here —
# a hard-coded value leaks into `next start` and triggers the "non-standard
# NODE_ENV" warning plus subtle dev/prod behaviour drift.
# NODE_ENV=""

# ── Secrets ─────────────────────────────────────────────────────────────
# 32+ char secrets. Generate each one with: openssl rand -base64 48
#
# NEVER reuse a value between the two, and never keep a shipped default in
# production — both are committed here, so they are public knowledge.
#
# Rotating either one has a cost, so rotate deliberately (see below).
#
# AUTH_SECRET — peppers every keyed hash: session tokens (`LoginSession`),
#   email verification / password reset tokens (`VerificationToken`), API-key
#   hashes (`ApiKey`) and CSRF tokens. The raw values are never stored, so
#   nothing can be re-derived from the old secret. Rotating it therefore:
#     • signs every browser session out (they must log in again), and
#     • invalidates every API key, which has to be re-issued.
#   Clear the rows first so the invalidation is deterministic rather than a
#   stream of "why is my key rejected" reports:
#     DELETE FROM LoginSession; DELETE FROM VerificationToken; DELETE FROM ApiKey;
AUTH_SECRET="change-me-dev-only-32-chars-minimum-secret-key"
#
# ENCRYPTION_KEY — encrypts values that must be readable again, today the TOTP
#   secrets in `User.twoFactorSecret` (AES-256-GCM, `v1.*` payloads). Losing the
#   old key without migrating makes every stored secret permanently unreadable.
#   Rotation is a two-stage move:
#     1. set ENCRYPTION_KEY to the new value and ENCRYPTION_KEY_OLD to the old one
#     2. npx tsx scripts/rotate-encryption-key.ts   (re-seals every payload)
#     3. remove ENCRYPTION_KEY_OLD and restart
#   Leaving ENCRYPTION_KEY_OLD set is safe but keeps the retired key in play, so
#   step 3 is not optional.
ENCRYPTION_KEY="change-me-dev-only-32-chars-minimum-encrypt-key"
# Previous ENCRYPTION_KEY, only while scripts/rotate-encryption-key.ts is pending.
# ENCRYPTION_KEY_OLD="the-previous-encryption-key-32-chars-minimum"

# ── WhatsApp Gateway service ─────────────────────────────────────
# Standalone process that owns Baileys sessions (see gateway/index.ts).
GATEWAY_PORT=4001
GATEWAY_HOST="127.0.0.1"
# Shared bearer token between the Next.js app and the gateway process. It only
# ever travels over loopback, and both processes read it at boot, so rotating it
# is a coordinated restart rather than a migration: replace the value, restart
# the gateway and the web app, and nothing is lost — no stored state depends on
# it. Do both, or the web app will be rejected with 401 until it is restarted.
GATEWAY_TOKEN="change-me-gateway-internal-token"

# ── Pakasir (payment gateway) ───────────────────────────────────────────────
# Server-side only. Both values come from the Pakasir project detail page.
# The webhook URL to paste back into that page is:
#   <NEXT_PUBLIC_APP_URL>/api/payments/pakasir/webhook
# A shorter alias serves the same handler: /api/webhook/pakasir
#
# The webhook is the fast path only. Pending invoices are also re-checked
# against Pakasir's status endpoint in the background, so a plan still
# activates when no notification arrives at all. That sweep is rate-limited
# by Pakasir, so it runs slowly on purpose.
PAKASIR_BASE_URL="https://app.pakasir.com"
PAKASIR_SLUG="your-project-slug"
PAKASIR_API_KEY="your-api-key"
PAKASIR_WEBHOOK_SECRET="your-webhook-secret"
# Payment reconciliation. Set PAYMENT_RECONCILE="0" to disable the sweep
# entirely; PAYMENT_RECONCILE_MS overrides the interval (default 120000).
PAYMENT_RECONCILE="1"
PAYMENT_RECONCILE_MS="120000"

# Free trial (3 days, once per account), in days.
# Set TRIAL_WATCH="0" to disable the background watchdog that ends a trial on
# time when nobody is looking; TRIAL_WATCH_MS overrides its interval (default
# 60000). The trial is enforced on every read regardless — the watchdog only
# makes sure the bot is stopped promptly when the panel is idle.
TRIAL_WATCH="1"
TRIAL_WATCH_MS="60000"

# Bot access (paywall). A bot may only be started, restarted or linked while
# the account has an active plan: a running trial, or a paid plan inside its
# period. No subscription, the legacy Rp0 "free" plan, an ended trial and an
# ended paid period all mean "no plan" — the API refuses (403) and the
# watchdog below stops a bot that was already running. Admin accounts are
# exempt so the operator can never be locked out of their own panel.
# ACCESS_WATCH="0" disables the watchdog; ACCESS_WATCH_MS sets its interval
# (default 60000). The gate itself is enforced on every request regardless.
ACCESS_WATCH="1"
ACCESS_WATCH_MS="60000"

# Renewal reminders. A paid plan inside its warning window gets one in-app
# notification and one activity entry per period, so nobody loses a bot to an
# end date they were never told about. Renewing clears the bookkeeping by
# moving the period end, so the next period is warned about independently.
# RENEWAL_WATCH="0" disables the sweep; RENEWAL_WATCH_MS sets its interval
# (default 300000); RENEWAL_WINDOW_DAYS sets how many days before the end the
# reminder goes out (default 3). Nothing here can start or stop a bot.
RENEWAL_WATCH="1"
RENEWAL_WATCH_MS="300000"
RENEWAL_WINDOW_DAYS="3"
# Where per-session Baileys auth state (creds/keys) is persisted.
# Format is identical to Nano's core/sesi.js, so a session can be
# handed straight to the Nano bot script.
GATEWAY_STORAGE_DIR="./storage/sessions"

# ── Engine driver ────────────────────────────────────────────────
# "local-baileys"  → gateway owns the session in-process (multi-session, default)
# "nano-process"   → gateway spawns the provided Nano script per session
# "nano-process" runs the Nano bot script as the engine (recommended).
# "local-baileys" owns the socket inside the gateway instead.
ENGINE_DRIVER="nano-process"

# Required only when ENGINE_DRIVER="nano-process"
# Path to the Nano bot script folder (the one with index.js). Both halves of the
# platform live under one root, so this is the in-repo location by default;
# resolve an absolute path, or a relative one from the project root.
NANO_ENGINE_DIR="/root/webbot/nano-engine"

# ── Logging (optional) ───────────────────────────────────────────
# Gateway pino level. Default "info". Use "debug" to see request/response
# detail, "silent" to quiet it.
# GATEWAY_LOG="info"
# Nano engine WhatsApp XML trace level. "trace" records every node to the
# WhatsApp server (diagnostics only — very noisy); default "silent".
# NANO_LOG="silent"
# Directory where the gateway writes its per-session bridge files for the
# nano-process driver. Normally the gateway picks a path automatically; set this
# only to relocate it.
# NANO_GATEWAY_BRIDGE_DIR=""

# ── Mail ─────────────────────────────────────────────────────────
# Without SMTP configured, verification / reset emails are queued in the outbox
# table instead of being sent, and the one-time link is NOT returned by the API
# (that link is a credential: whoever holds it can verify an address or take
# over an account). Configure SMTP for a real deployment.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="NANO GATEWAY <no-reply@nanogateway.local>"

# ── Development-only auth links ──────────────────────────────────
# Set to 1 ONLY on a local machine with no mail server, to get verification and
# password-reset links back in the API response (so flows can be completed by
# hand). Any other value (unset / 0 / false) keeps those tokens server-side.
# Never enable this on a public deployment.
DEV_AUTH_LINKS="0"

# ── OAuth (optional social login) ────────────────────────────────
# Leave empty to hide the provider button on the login page.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Billing ──────────────────────────────────────────────────────
# Manual/offline billing is the default. Set a provider to enable checkout.
BILLING_PROVIDER="manual"

# ── Realtime ─────────────────────────────────────────────────────
# SSE is used by default (no extra port). Set to 1 to prefer websockets
# when a socket server is available.
REALTIME_TRANSPORT="sse"
