{
  "name": "nano-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NANO GATEWAY — WhatsApp Gateway & Bot Management Platform",
  "scripts": {
    "dev": "concurrently -n web,gateway -c cyan,green \"npm:dev:web\" \"npm:dev:gateway\"",
    "dev:web": "next dev -p ${PORT:-3000}",
    "dev:gateway": "tsx watch gateway/index.ts",
    "prebuild": "npm run check:branding",
    "build": "NODE_OPTIONS=--max-old-space-size=1536 next build",
    "start": "concurrently -n web,gateway -c cyan,green \"npm:start:web\" \"npm:start:gateway\"",
    "start:web": "next start -p ${PORT:-3000}",
    "start:gateway": "tsx gateway/index.ts",
    "gateway": "tsx gateway/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:branding": "tsx scripts/check-branding.ts",
    "proxy:update": "node scripts/update-proxy-pool.js",
    "db:seed": "tsx prisma/seed.ts",
    "dev:web:safe": "bash scripts/dev-safe.sh -p ${PORT:-3200}",
    "deploy": "bash scripts/deploy.sh",
    "deploy:rebuild": "bash scripts/deploy.sh --no-build",
    "deploy:ram": "NANO_DEPLOY_RAM_GUARD=1 bash scripts/deploy.sh"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.1.0",
    "lucide-react": "1.48.0",
    "mongodb": "^7.9.1",
    "motion": "13.4.4",
    "next": "^15.5.26",
    "next-themes": "0.4.6",
    "otpauth": "9.4.1",
    "papaparse": "5.5.3",
    "pino": "9.13.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.9.1",
    "@types/papaparse": "5.3.16",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^9.2.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "//type": "ESM project-wide. @whiskeysockets/baileys and its dependency whatsapp-rust-bridge are ESM-only (their exports maps expose only the `import` condition), so the gateway process cannot load them from CommonJS, and an ESM/CJS split hides named exports across the boundary. One module system for web + gateway avoids both problems.",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true
  },
  "//overrides": "Pin the postcss transitive build-tool advisory to a patched release. `npm audit fix --force` would drag next 15 -> 16, so the range is narrowed here instead. Compile-time only (postcss runs while Next compiles CSS) — not reachable from a user request.",
  "overrides": {
    "postcss": "^8.5.28"
  }
}
