[Unit]
Description=Nano Gateway — WhatsApp web server (Next.js)
After=network.target nano-gateway-engine.service

[Service]
Type=simple
EnvironmentFile=/root/webbot/.env
Environment=PORT=3005
WorkingDirectory=/root/webbot
ExecStart=/usr/bin/node /root/webbot/node_modules/.bin/next start -H 127.0.0.1 -p 3005
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nano-gateway-web

[Install]
WantedBy=multi-user.target
