[Unit]
Description=Nano Gateway — WhatsApp engine service (Baileys / Nano driver)
After=network.target

[Service]
Type=simple
EnvironmentFile=/root/webbot/.env
Environment=GATEWAY_HOST=127.0.0.1 GATEWAY_PORT=4001
WorkingDirectory=/root/webbot
ExecStart=/usr/bin/npx tsx gateway/index.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nano-gateway-engine

[Install]
WantedBy=multi-user.target
